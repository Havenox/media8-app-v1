# ============================================
# MEDIA 8 - INFRAESTRUTURA (Docker Compose)
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commitar este arquivo com dados reais

# ============================================
# BANCO DE DADOS (PostgreSQL)
# ============================================
# Host do banco de dados
# Desenvolvimento: localhost ou IP da rede local
# Producao: dominio ou IP do servidor
DB_HOST=192.168.18.110

# Porta do PostgreSQL
DB_PORT=5432

# Nome do banco de dados
DB_NAME=media8

# Usuario do banco de dados
DB_USERNAME=media8

# Senha do banco de dados (Mudar em producao!)
DB_PASSWORD=Guerra2024!

# String de conexao completa (usada pelo backend .NET)
# Envolva em aspas duplas se conter caracteres especiais
DB_CONNECTION_STRING="Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USERNAME};Password=${DB_PASSWORD}"

# ============================================
# SEGURANCA (JWT)
# ============================================
# Chave secreta para assinatura do JWT
# Deve ter pelo menos 32 caracteres em producao
# Gerar uma nova chave segura: openssl rand -base64 32
JWT_SECRET=M8_PRODUCTION_SECRET_KEY_CHANGE_THIS_TO_SOMETHING_VERY_SECURE_IN_REAL_PROD_1233

# ============================================
# BACKEND (.NET API)
# ============================================
# Ambiente ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Porta HTTP da API
ASPNETCORE_HTTP_PORTS=80

# Seed de usuarios iniciais
SEED_USERS_FROM_JSON=false

# ============================================
# FRONTEND (Vite/React)
# ============================================
# URL da API Backend (usada pelo frontend)
# Desenvolvimento local: http://localhost:5261/api/v1
# Docker: http://media8-api:80/api/v1
# Producao: https://api.seudominio.com.br/api/v1
VITE_API_URL=http://localhost:5261/api/v1

# ============================================
# OPCIONAIS (Integracoes Futuras)
# ============================================
# Webhook para notificacoes (n8n, Zapier, etc.)
# WEBHOOK_NOTIFICATION_URL=https://seu-n8n.com/webhook/...

# Chave de API para servicos externos (ex: Stripe, SendGrid)
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=

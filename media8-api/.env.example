# ============================================
# MEDIA 8 - BACKEND (.NET API)
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commitar este arquivo com dados reais

# ============================================
# BANCO DE DADOS (PostgreSQL)
# ============================================
# String de conexao completa
# Para desenvolvimento local com Docker:
# DB_CONNECTION_STRING="Host=localhost;Port=5432;Database=media8;Username=media8;Password=SuaSenhaAqui"
#
# Para producao, use variaveis de ambiente hierarquicas:
# ConnectionStrings__DefaultConnection="Host=...;..."
DB_CONNECTION_STRING="Host=localhost;Port=5432;Database=media8;Username=media8;Password=SuaSenhaAqui"

# ============================================
# SEGURANCA (JWT)
# ============================================
# Chave secreta para assinatura do JWT
# Deve ter pelo menos 32 caracteres em producao
# Gerar uma nova chave segura: openssl rand -base64 32
JWT_SECRET=SuaChaveSecretaJWT_AltamenteSegura_Com32CaracteresNoMinimo!

# ============================================
# CONFIGURACOES ASP.NET CORE
# ============================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5261

# Seed de usuarios iniciais (apenas desenvolvimento)
SEED_USERS_FROM_JSON=false

# ============================================
# OPCIONAIS
# ============================================
# Webhook para notificacoes
# WEBHOOK_NOTIFICATION_URL=https://seu-n8n.com/webhook/...

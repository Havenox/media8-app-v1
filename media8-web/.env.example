# ============================================
# MEDIA 8 - FRONTEND (Vite/React)
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commitar este arquivo com dados reais
#
# Nota: Variaveis VITE_ sao expostas ao navegador
# NUNCA coloque segredos (senhas, chaves de API) aqui

# ============================================
# API BACKEND
# ============================================
# URL da API Backend
# Desenvolvimento local: http://localhost:5261/api/v1
# Docker: http://media8-api:80/api/v1
# Producao: https://api.seudominio.com.br/api/v1
VITE_API_URL=http://localhost:5261/api/v1

# ============================================
# DADOS SUGERIDOS (Apenas documentacao)
# ============================================
# Estes valores sao apenas para referencia
# Nao afetam o codigo em tempo de execucao
VITE_ADMIN_USER=admin@media8.com
VITE_ADMIN_PASSWORD=Admin123!

# ============================================
# OPCIONAIS
# ============================================
# URL para servico de upload de arquivos (ex: S3, Cloudinary)
# VITE_UPLOAD_URL=https://upload.seudominio.com

# Chave de servicos (se necessario no frontend)
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
